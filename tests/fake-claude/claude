#!/usr/bin/env bash
# Fake claude for relay tests. No API, no network: each invocation plays one
# action from FAKE_PLAN (comma list): work | done | done-lie.
# Emits the same JSON shape as `claude -p --output-format json`.
set -u
mkdir -p .relay
count_file=".relay/fake-calls"
n=0; [ -f "$count_file" ] && n=$(cat "$count_file")
n=$(( n + 1 )); echo "$n" > "$count_file"
plan="${FAKE_PLAN:-work,done}"
action=$(printf '%s' "$plan" | cut -d, -f"$n")
[ -n "$action" ] || action=done

echo "leg $n fake work" > "out-$n.txt"
printf '\n## Leg %s\nfake claude leg %s ran action %s\n' "$n" "$n" "$action" >> .relay/baton.md

case "$action" in
  done)
    echo proof > proof.txt
    printf '# DONE\nEvidence: created out files and proof.txt\n' > .relay/DONE.md
    ;;
  done-lie)
    printf '# DONE\nEvidence: trust me\n' > .relay/DONE.md
    ;;
esac
printf '{"type":"result","session_id":"fake-%s","result":"leg %s ended"}\n' "$n" "$n"
exit 0
